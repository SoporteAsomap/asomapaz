# ============================================================
# COPIA ESTE ARCHIVO A .env Y COMPLETA LOS VALORES
# cp .env.example .env
# ============================================================
#
# MODO IP LOCAL (red interna)
#   SERVER_IP=192.168.1.50
#   SERVER_PROTOCOL=http
#   SERVER_PORT=8080
#
# MODO DOMINIO PUBLICO (internet con HTTPS)
#   SERVER_IP=asomap.com
#   SERVER_PROTOCOL=https
#   SERVER_PORT=443
#
# ============================================================

# ============================================================
# BASE DE DATOS
# ============================================================
DB_USER=asomap_user
DB_PASS=CAMBIAR_POR_PASSWORD_SEGURO
DB_NAME=asomap
DB_HOST=db
DB_PORT=5432
USE_DOCKER_DB=True

# ============================================================
# DJANGO
# ============================================================
DEBUG=False

# Genera una clave segura con:
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CAMBIAR_POR_CLAVE_SECRETA_UNICA

# ============================================================
# SERVIDOR
# Opcion A — IP local:   SERVER_IP=192.168.1.50   SERVER_PORT=8080   SERVER_PROTOCOL=http
# Opcion B — Dominio:    SERVER_IP=asomap.com      SERVER_PORT=443    SERVER_PROTOCOL=https
# ============================================================
SERVER_IP=000.000.000.000
SERVER_PORT=8080
SERVER_PROTOCOL=http

# Hosts permitidos — agregar IP y dominio si aplica
# Ejemplo con dominio: ALLOWED_HOSTS=127.0.0.1,localhost,asomap.com,www.asomap.com
ALLOWED_HOSTS=127.0.0.1,0.0.0.0,localhost,000.000.000.000

# CORS — origenes permitidos para llamadas desde el navegador
# Ejemplo con dominio: CORS_ALLOWED_ORIGINS=https://asomap.com,https://www.asomap.com
CORS_ALLOWED_ORIGINS=http://000.000.000.000:8080,http://localhost:8080

# CSRF — origenes de confianza para formularios
# Ejemplo con dominio: CSRF_TRUSTED_ORIGINS=https://asomap.com,https://www.asomap.com
CSRF_TRUSTED_ORIGINS=http://000.000.000.000:8080,http://localhost:8080

# ============================================================
# FRONTEND
# URL que el NAVEGADOR usa para llamar a la API.
# Debe ser accesible desde el cliente, no desde el servidor.
#
# Ejemplo con IP:     VITE_API_URL=http://192.168.1.50:8080
# Ejemplo con dominio: VITE_API_URL=https://asomap.com
# ============================================================
VITE_API_URL=http://000.000.000.000:8080
VITE_ENV=production

# Opcional — clave de Google Maps
VITE_GOOGLE_MAPS_API_KEY=

# ============================================================
# MEDIA Y ESTATICOS (no cambiar)
# ============================================================
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles
